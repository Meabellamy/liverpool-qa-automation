# Base URL of the site under test
BASE_URL=https://www.liverpool.com.mx

# Data-driven search parameters (no hardcoded values in test code)
SEARCH_TERM=playstation 5
COLOR_FILTER=Blanco

# How many top results to extract and validate
RESULTS_LIMIT=5

# Minimum number of UI results that must be cross-validated against the intercepted API response
MIN_CROSS_VALIDATION_MATCHES=3
